{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dailyblip.github.io/IPO-Tracking/schemas/filings-v1.schema.json",
  "title": "Research Monitor public filings feed V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "filings"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source": {"const": "SEC EDGAR"},
    "filings": {
      "type": "array",
      "items": {"$ref": "#/$defs/filing"}
    }
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "nullableNumber": {"type": ["number", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "dateOrNull": {
      "anyOf": [
        {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        {"type": "null"}
      ]
    },
    "lockupTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_value": {"type": ["integer", "number", "null"]},
        "duration_unit": {"type": ["string", "null"]},
        "duration_days": {"type": ["integer", "null"]},
        "scope_tags": {"type": "array", "items": {"type": "string"}},
        "scope": {"type": ["string", "null"]},
        "special_holder": {"type": ["string", "null"]},
        "tranche_percent": {"type": ["number", "null"]},
        "tranche_label": {"type": ["string", "null"]},
        "covers_full_position": {"type": "boolean"},
        "has_staggered_releases": {"type": "boolean"},
        "score": {"type": ["integer", "number", "null"]},
        "source_text": {"type": ["string", "null"]},
        "end_date": {"$ref": "#/$defs/dateOrNull"}
      }
    },
    "lockupScheduleTerm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_value": {"type": ["integer", "number", "null"]},
        "duration_unit": {"type": ["string", "null"]},
        "end_date": {"$ref": "#/$defs/dateOrNull"},
        "scope": {"type": ["string", "null"]},
        "special_holder": {"type": ["string", "null"]},
        "source_text": {"type": ["string", "null"]},
        "has_staggered_releases": {"type": ["boolean", "null"]},
        "tranche_percent": {"type": ["number", "null"]},
        "tranche_label": {"type": ["string", "null"]},
        "covers_full_position": {"type": ["boolean", "null"]}
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "stanford_university_bio"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "shares": {"type": ["number", "null"]},
        "cash_value": {"type": ["number", "null"]},
        "stanford_university_bio": {"type": "boolean"},
        "ipo_value": {"type": ["number", "null"]},
        "liquid_shares": {"type": ["number", "null"]},
        "liquid_value": {"type": ["number", "null"]},
        "locked_shares": {"type": ["number", "null"]},
        "locked_value": {"type": ["number", "null"]},
        "cash_realized_ipo": {"type": ["number", "null"]},
        "liquidity_status": {"type": ["string", "null"]},
        "liquidity_confidence": {"type": ["string", "null"]},
        "holder_type": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "ownership_percent": {"type": ["number", "string", "null"]},
        "ownership_percent_before": {"type": ["number", "string", "null"]},
        "ownership_percent_after": {"type": ["number", "string", "null"]},
        "shares_before_ipo": {"type": ["number", "string", "null"]},
        "shares_sold_ipo": {"type": ["number", "string", "null"]},
        "shares_after_ipo": {"type": ["number", "string", "null"]},
        "stanford_source": {"type": ["string", "null"]},
        "lockup_end_date": {"$ref": "#/$defs/dateOrNull"},
        "lockup_scope": {"type": ["string", "null"]},
        "lockup_duration_days": {"type": ["integer", "null"]},
        "lockup_duration_value": {"type": ["integer", "number", "string", "null"]},
        "lockup_duration_unit": {"type": ["string", "null"]},
        "lockup_schedule": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockupScheduleTerm"}
        },
        "lockup_text": {"type": ["string", "null"]},
        "valuation_as_of": {"type": ["string", "null"]}
      }
    },
    "filing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "company", "ticker", "cik", "accession_no", "form", "filed",
        "stage", "priority", "status", "value", "value_label", "people_count",
        "signals", "people", "sec_url"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "company": {"type": "string", "minLength": 1},
        "ticker": {"type": "string"},
        "cik": {"type": "string", "pattern": "^(?:\\d{10})?$"},
        "accession_no": {"type": "string"},
        "form": {"type": "string", "minLength": 1},
        "filed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "filing_date": {"$ref": "#/$defs/dateOrNull"},
        "pricing_date": {"$ref": "#/$defs/dateOrNull"},
        "priority": {"type": "string"},
        "status": {"type": "string"},
        "value": {"type": ["number", "null"]},
        "value_label": {"type": "string"},
        "people_count": {"type": "integer", "minimum": 0},
        "signals": {"type": "array", "items": {"type": "string"}},
        "people": {"type": "array", "items": {"$ref": "#/$defs/person"}},
        "sec_url": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "price_range": {"type": ["string", "null"]},
        "filing_price": {"type": ["string", "number", "null"]},
        "offering_price": {"type": ["number", "null"]},
        "current_price": {"type": ["number", "null"]},
        "price_updated": {"type": ["string", "null"]},
        "location": {"type": ["string", "null"]},
        "location_source": {"type": ["string", "null"]},
        "primary_offering_shares": {"type": ["number", "null"]},
        "secondary_offering_shares": {"type": ["number", "null"]},
        "offering_size_source": {"type": ["string", "null"]},
        "offering_size_confidence": {"type": ["string", "null"]},
        "lockup_end_date": {"$ref": "#/$defs/dateOrNull"},
        "lockup_duration_days": {"type": ["integer", "null"]},
        "lockup_duration_value": {"type": ["integer", "number", "string", "null"]},
        "lockup_duration_unit": {"type": ["string", "null"]},
        "lockup_text": {"type": ["string", "null"]},
        "lockup_scope": {"type": ["string", "null"]},
        "lockup_terms": {"type": "array", "items": {"$ref": "#/$defs/lockupTerm"}},
        "lockup_confidence": {"type": ["string", "null"]}
      }
    }
  }
}
